{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Event v0.1",
  "type": "object",
  "required": [
    "event_id",
    "brand_id",
    "occurred_at",
    "kind",
    "actor",
    "artifact_ref",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "created",
        "reviewed",
        "decided",
        "approved",
        "rejected",
        "superseded",
        "exported",
        "corrected"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "related_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
