{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Context Request v0.1",
  "type": "object",
  "required": [
    "request_id",
    "requester",
    "purpose",
    "audience",
    "topics"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "enum": [
        "public",
        "shared",
        "restricted"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "brand_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "as_of": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
