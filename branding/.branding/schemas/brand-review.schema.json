{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Review v0.1",
  "type": "object",
  "required": [
    "review_id",
    "brand_id",
    "artifact_id",
    "artifact_version",
    "reviewed_at",
    "status",
    "findings"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_version": {
      "type": "integer",
      "minimum": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "fail",
        "inconclusive"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "issue",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major",
              "critical"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "method_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
