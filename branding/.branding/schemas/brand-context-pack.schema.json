{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand Context Pack v0.1",
  "type": "object",
  "required": [
    "request_id",
    "requester",
    "purpose",
    "audience",
    "generated_at",
    "profiles",
    "excluded_count",
    "limitations"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "enum": [
        "public",
        "shared",
        "restricted"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "excluded_count": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
