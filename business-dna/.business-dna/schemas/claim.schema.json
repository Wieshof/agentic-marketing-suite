{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business-DNA Claim v0.1",
  "type": "object",
  "required": [
    "claim_id",
    "subject",
    "predicate",
    "value",
    "status",
    "visibility",
    "version",
    "updated_at",
    "source_refs"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "declared",
        "planned",
        "hypothesis",
        "disputed",
        "superseded",
        "rejected",
        "unknown"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "shared",
        "restricted"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "review_due_at": {
      "type": "string",
      "format": "date"
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
