{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/creative-job.schema.json",
  "title": "Creative production job v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "title",
    "medium",
    "status",
    "assets",
    "deliverables"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "medium": {
      "enum": [
        "print",
        "digital_image",
        "video",
        "audio",
        "animation",
        "multimedia"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "concept_review",
        "production",
        "technical_qa",
        "visual_qa",
        "rework",
        "approval_pending",
        "approved",
        "released"
      ]
    },
    "brand_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "rights_status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "rights_status": {
            "enum": [
              "verified",
              "unverified",
              "restricted"
            ]
          },
          "license_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "format",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "purpose": {
            "enum": [
              "proof",
              "editable_source",
              "final"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "print_spec": {
      "type": "object",
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "trim_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "trim_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bleed_mm": {
          "type": "number",
          "minimum": 0
        },
        "output_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_pdf_standard": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "dpi_target": {
          "type": [
            "number",
            "null"
          ]
        },
        "print_method": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "qa": {
      "type": "object",
      "properties": {
        "technical": {
          "enum": [
            "not_run",
            "failed",
            "passed"
          ]
        },
        "visual": {
          "enum": [
            "not_run",
            "failed",
            "passed"
          ]
        },
        "qa_artifact_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdfx_validator": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdfx_report": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights": {
          "enum": [
            "not_checked",
            "failed",
            "passed"
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
