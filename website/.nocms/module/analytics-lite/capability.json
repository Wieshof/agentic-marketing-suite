{
  "id": "web.analytics-lite",
  "version": "0.1",
  "owner_module": "website",
  "kind": "webmodule",
  "purpose": "Aggregierte Seitenaufrufe ohne Cookies oder dauerhafte Nutzerkennungen zählen.",
  "entrypoint": "website/.nocms/module/analytics-lite/analytics.php",
  "configuration": "website/.nocms/module/common/config.example.json",
  "prerequisites": [
    "PHP 8.3+",
    "Freigegebene statische Seitenliste",
    "Geprüfte Daten-/Rechtsgrundlage"
  ],
  "inputs": [
    "Zugelassener Seitenpfad ohne Query",
    "Optionaler first-party JS-Aufruf"
  ],
  "outputs": [
    "Tag/Seite/Seitenaufrufe",
    "CSV-Export für analytics"
  ],
  "checks": [
    "DNT/GPC",
    "Feste Routen",
    "Keine IP-/UA-/Referrer-Speicherung",
    "Retention"
  ],
  "statuses": [
    "disabled",
    "counted",
    "skipped"
  ],
  "external_actions": [
    "none"
  ]
}
