{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advertising action manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "platform",
    "action",
    "status",
    "account_ref",
    "objective",
    "currency",
    "budget",
    "creatives",
    "landing_url",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 3
    },
    "platform": {
      "type": "string",
      "minLength": 2
    },
    "action": {
      "enum": [
        "draft",
        "stage_paused",
        "activate",
        "update",
        "pause",
        "report"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_review",
        "approved",
        "staged",
        "active",
        "paused",
        "completed",
        "error",
        "rejected"
      ]
    },
    "account_ref": {
      "type": "string",
      "minLength": 2
    },
    "objective": {
      "type": "string",
      "minLength": 2
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifetime_max",
        "daily_max",
        "period_start",
        "period_end"
      ],
      "properties": {
        "lifetime_max": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        "daily_max": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "creatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "search_ads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_name",
        "ad_groups"
      ],
      "properties": {
        "campaign_name": {
          "type": "string",
          "minLength": 1
        },
        "ad_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "final_url",
              "headlines",
              "descriptions"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "final_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "path1": {
                "type": "string",
                "maxLength": 15
              },
              "path2": {
                "type": "string",
                "maxLength": 15
              },
              "headlines": {
                "type": "array",
                "minItems": 3,
                "maxItems": 15,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 30
                }
              },
              "descriptions": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 90
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "match"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "match": {
                      "enum": [
                        "broad",
                        "phrase",
                        "exact"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "landing_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "tracking_status": {
      "enum": [
        "not_required",
        "unverified",
        "verified",
        "blocked"
      ]
    },
    "claims_reviewed": {
      "type": "boolean"
    },
    "legal_reviewed": {
      "type": "boolean"
    },
    "capability_preflight": {
      "type": "boolean"
    },
    "platform_account_verified": {
      "type": "boolean"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "approved_action",
        "approved_budget",
        "approved_by"
      ],
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_action": {
          "enum": [
            "none",
            "stage_paused",
            "activate",
            "update",
            "pause",
            "report"
          ]
        },
        "approved_budget": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
